# PostgreSQL Database URL
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>

# Option 1: Local PostgreSQL installation or Docker
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nashik_misal

# Option 2: Managed Cloud PostgreSQL (Supabase, Neon, Railway, Render, ElephantSQL)
# DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-1.aws.neon.tech/neondb?sslmode=require

# Option 3: Fallback to local SQLite (default)
# DATABASE_URL=sqlite:///./nashik_misal.db
